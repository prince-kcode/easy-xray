# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py
staticfiles/

# Environments
venv/
env/
ENV/
.venv/

# Node / Vite Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Datasets (Strictly Excluded)
dataset/
detector_data/
cifar_temp/
archive.zip
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.csv
data/
thoracic_disease_classification/data/images/*
!thoracic_disease_classification/data/images/.gitkeep
thoracic_disease_classification/data/csv/*
!thoracic_disease_classification/data/csv/.gitkeep

# Large Model Weights (Binary Weights > 40MB)
models/*.pth
models/*.pt
models/*.bin
models/*.onnx
!models/README.md
!models/.gitkeep
thoracic_disease_classification/models/*.pth
thoracic_disease_classification/models/*.pt
!thoracic_disease_classification/models/.gitkeep

# Runtime Media Uploads & Temp Files
media/uploads/*
media/heatmaps/*
media/temp_val/*
media/scans/*
!media/uploads/.gitkeep
!media/heatmaps/.gitkeep
!media/temp_val/.gitkeep
!media/scans/.gitkeep

# Outputs & Notebooks
thoracic_disease_classification/outputs/plots/*
!thoracic_disease_classification/outputs/plots/.gitkeep
thoracic_disease_classification/outputs/results/*
!thoracic_disease_classification/outputs/results/.gitkeep
thoracic_disease_classification/notebooks/.ipynb_checkpoints/
!thoracic_disease_classification/notebooks/.gitkeep

# OS & IDE Cache
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
